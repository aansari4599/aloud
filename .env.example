# Any OpenAI-compatible endpoint works (OpenAI, Gemini, Groq, …)
OPENAI_API_KEY=
# Leave unset for api.openai.com; Gemini example:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini

# GitHub PR flow (demo repo only — use a fine-grained PAT scoped to that single repo)
GH_TOKEN=
GH_DEMO_REPO=yourname/aloud-demo-site

# Set by the Dockerfile in production (Railway volume); local default is ./data
# DATABASE_PATH=/data/aloud.db
# SCREENSHOT_DIR=/data/shots
# BASE_URL=https://your-app.up.railway.app
